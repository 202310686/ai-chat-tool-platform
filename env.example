AUTH_SECRET=replace-with-a-long-random-string
AUTH_URL=http://localhost:3000
# AUTH_TRUST_HOST=true

# Configure either DeepSeek or OpenAI on the server.
# DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-flash
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional external PostgreSQL. If omitted, local PGlite is used.
# DATABASE_URL=postgresql://user:password@localhost:5432/ai_platform

# Recommended for public demos. Share the code only with intended users.
# REGISTRATION_CODE=choose-a-long-random-code
CHAT_DAILY_LIMIT=20
STRUCTURED_DAILY_LIMIT=10
